# Build products. Everything here is regenerated by ./build.sh, and the whole
# point of the toolchain is that it can be: design.py is the source of truth.
build/

# The fabrication outputs under fab/ are deliberately NOT ignored -- they are
# the deliverable, and having them in the tree is what lets a change to the
# board be reviewed as a diff.

__pycache__/
*.py[cod]

# KiCad writes this alongside the project to remember window layout, the
# selected layer and similar per-user state. It is not part of the design.
rmc-pizz-arco/*.kicad_prl

# JetBrains project settings. Per-user editor state, not part of the design.
.idea/

.DS_Store
*.iml